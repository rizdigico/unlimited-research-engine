# Read the documentation before extending the defaults:
# https://docs.searxng.org/admin/settings/

use_default_settings: true

server:
  secret_key: "RZ1fPdnW6BhoaFHihrcdcSZSgcG1Tp"
  image_proxy: true

search:
  safe_search: 0
  autocomplete: "duckduckgo"

ui:
  static_use_hash: true

result_proxy:
  enabled: false

engines:
  - name: google
    engine: google
    shortcut: go
    disabled: false
  - name: bing
    engine: bing
    shortcut: bi
    disabled: false
  - name: brave
    engine: brave
    shortcut: br
    disabled: false
  - name: duckduckgo
    engine: duckduckgo
    shortcut: ddg
    disabled: false
  - name: startpage
    engine: startpage
    shortcut: sp
    disabled: false
  - name: qwant
    engine: qwant
    shortcut: qw
    disabled: false
  - name: wikipedia
    engine: wikipedia
    shortcut: wp
    disabled: false

plugins:
  - plugin: ' searx.plugins.ahmia_filter'
    name: 'Ahmia blacklist'
    disabled: true
  - plugin: ' searx.plugins.calculator'
    name: 'Calculator'
    disabled: false
  - plugin: ' searx.plugins.hostnames'
    name: 'Hostnames plugin'
    disabled: true
  - plugin: ' searx.plugins.oceanpress'
    name: 'OceanPress'
    disabled: true
  - plugin: ' searx.plugins.vedaled'
    name: 'Vedaled'
    disabled: true
